{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_NO_METRO_LAZY=1",
        "npm",
        "exec",
        "-w",
        "@vedic-patro/mobile",
        "--",
        "expo",
        "start",
        "--clear",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "mobile-local-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_NO_METRO_LAZY=1",
        "EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000",
        "npm",
        "exec",
        "-w",
        "@vedic-patro/mobile",
        "--",
        "expo",
        "start",
        "--clear",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@vedic-patro/web",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "-w",
        "@vedic-patro/mobile",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-test-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_BASE_URL=http://localhost:8090",
        "npm",
        "run",
        "dev",
        "-w",
        "@vedic-patro/web",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "-w",
        "@vedic-patro/web",
        "--",
        "--port",
        "4199",
        "--strictPort"
      ],
      "port": 4199
    },
    {
      "name": "web-review",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_BASE_URL=/api",
        "npm",
        "run",
        "dev",
        "-w",
        "@vedic-patro/web",
        "--",
        "--port",
        "5176",
        "--strictPort"
      ],
      "port": 5176
    }
  ]
}
