{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@vedic-patro/web",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "-w",
        "@vedic-patro/mobile",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-test-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_API_BASE_URL=http://localhost:8090",
        "npm",
        "run",
        "dev",
        "-w",
        "@vedic-patro/web",
        "--",
        "--port",
        "5175",
        "--strictPort"
      ],
      "port": 5175
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "-w",
        "@vedic-patro/web",
        "--",
        "--port",
        "4199",
        "--strictPort"
      ],
      "port": 4199
    }
  ]
}
