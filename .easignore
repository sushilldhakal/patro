# EAS packs the whole monorepo (the git root), so this file lives here, not in
# apps/mobile. The phone build only needs apps/mobile + packages/*; drop the
# heavy web/API payload. Every package.json stays so the workspace lockfile
# still installs.

# Website static assets (3D sky tiles, learn images) — mobile fetches sky tiles remotely.
/apps/web/public

# API data (databases, source JSON, ephemeris) and Python tests/caches.
/apps/api/data
/apps/api/tests
/apps/api/cache
**/__pycache__
**/*.pyc

# Store submission material, not part of the app binary.
/apps/mobile/store/builds
/apps/mobile/store/screenshots
/apps/mobile/store/assets
/apps/mobile/store/secrets

# Let EAS prebuild fresh native projects for the current SDK.
# Local android/ and ios/ are leftover from SDK 54 and break Play AABs.
/apps/mobile/android
/apps/mobile/ios
/apps/mobile/dist
/apps/mobile/dist-web
/apps/mobile/web-build
/apps/mobile/.expo
