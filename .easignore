# NOTE: EAS uses this file INSTEAD of .gitignore (it does not merge them), and it
# packs the whole monorepo from the git root. So everything .gitignore excludes
# has to be repeated here, plus the heavy web/API payload the phone build skips.

# ── Same as .gitignore ──
.git
node_modules
**/node_modules
.turbo
**/.turbo
.DS_Store
.venv
**/.venv
venv
.env
.env.local
**/.env
**/.env.local
.deploy
scripts/design-parity/out
/data
/cache
__pycache__
*.pyc
*.egg-info
**/.expo
**/dist
**/web-build
.pytest_cache
**/.pytest_cache
.claude

# ── Not needed for the phone build ──
# Website static assets (mobile fetches the 3D sky tiles remotely).
/apps/web/public
# API data, tests and caches.
/apps/api/data
/apps/api/tests
/apps/api/cache
# Store submission material, not part of the app binary.
/apps/mobile/store/builds
/apps/mobile/store/screenshots
/apps/mobile/store/assets
/apps/mobile/store/secrets
# Stale native projects — EAS prebuilds fresh ones for the current SDK.
/apps/mobile/android
/apps/mobile/ios
/apps/mobile/dist-web
