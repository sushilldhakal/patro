{
  "expo": {
    "name": "Vedic Patro",
    "slug": "vedic-patro-mobile",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "vedicpatro",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#073f43",
    "description": "Nepali Bikram Sambat calendar, daily panchanga, kundali, muhurta, and sky view — in Nepali and English.",
    "githubUrl": "https://github.com/sushilldhakal/patro",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "locales": {
      "en": "./store/locales/en.json",
      "ne": "./store/locales/ne.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vedicpatro.mobile",
      "appleTeamId": "H6AS5X74R2",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:www.vedicpatro.com",
        "applinks:vedicpatro.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "Vedic Patro uses the camera only in Aakash Gochar to show the live sky behind the sky map. We do not take photos, record video, or upload camera data. You can use the sky map without the camera.",
        "NSLocationWhenInUseUsageDescription": "Vedic Patro uses your location while the app is open to calculate panchanga, sunrise and muhurta for your place, and to align the 3D sky compass with true north. You can search a city instead. We do not use location in the background or for advertising.",
        "NSMotionUsageDescription": "Vedic Patro uses motion and compass in Aakash Gochar so the sky turns as you tilt and turn the phone. This data stays on your device and is not stored or sent to our servers. You can drag the sky by hand instead.",
        "NSFaceIDUsageDescription": "Vedic Patro can use Face ID to unlock saved sign-in details on this device.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "vedicpatro"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "fb1044570391345268"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": [
          "fbapi",
          "fb-messenger-share-api",
          "fbauth2",
          "fbshareextension"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePreciseLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#073f43"
      },
      "package": "com.vedicpatro.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_PHONE_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.vedicpatro.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "vedicpatro.com",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "vedicpatro"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "fb1044570391345268"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.ico",
      "name": "Vedic Patro",
      "shortName": "Vedic Patro",
      "lang": "ne",
      "themeColor": "#073f43",
      "backgroundColor": "#073f43"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-dontwarn com.google.mlkit.**\n-dontwarn com.google.android.gms.internal.mlkit_**\n-dontwarn androidx.camera.mlkit.**"
          }
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#073f43"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Vedic Patro can use Face ID to unlock saved sign-in details on this device."
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Vedic Patro uses your location while the app is open to calculate panchanga, sunrise and muhurta for your place, and to align the 3D sky compass with true north. You can search a city instead. We do not use location in the background or for advertising.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Vedic Patro uses the camera only in Aakash Gochar to show the live sky behind the sky map. We do not take photos, record video, or upload camera data. You can use the sky map without the camera.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://www.vedicpatro.com/api",
      "apiVersion": "v1",
      "privacyPolicyUrl": "https://www.vedicpatro.com/privacy",
      "termsOfUseUrl": "https://www.vedicpatro.com/terms",
      "supportUrl": "https://www.vedicpatro.com",
      "supportEmail": "support@vedicpatro.com",
      "googleWebClientId": "568648791161-elpu27mjfjhcb3p9rm2vim62kgrqinao.apps.googleusercontent.com",
      "googleIosClientId": "568648791161-4o9fdadb47ltb2nfp1fsdbj03u50q509.apps.googleusercontent.com",
      "googleAndroidClientId": "568648791161-0dhpp9t58h249d0ema1lmk3nm00euql0.apps.googleusercontent.com",
      "facebookAppId": "1044570391345268",
      "router": {},
      "eas": {
        "projectId": "875bd091-9544-4881-9b60-7a268c11a7ac"
      },
      "googleIosReversedClientId": ""
    }
  }
}
