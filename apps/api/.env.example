# Server (used by systemd / local uvicorn)
HOST=0.0.0.0
PORT=8000

# ── Concurrency ──
# Worker processes uvicorn runs (read by the systemd unit; this line wins over its
# default). Panchanga maths is CPU-bound, but with Redis most requests are cache
# hits, so extra workers add concurrent capacity. RAM is the limit: ~100–300 MB
# per worker. Keep WEB_CONCURRENCY × (DB_POOL_SIZE + DB_MAX_OVERFLOW) < Postgres
# max_connections (100): 10 × (3 + 2) = 50.
WEB_CONCURRENCY=10
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

# ── Redis cache (shared by all workers; optional) ──
# Unset = no Redis, everything falls back to Postgres/disk exactly as before.
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_CACHE_TTL_S=604800        # 7 days; the server evicts LRU at its maxmemory anyway
# REDIS_MAX_VALUE_BYTES=8388608   # skip caching payloads bigger than this
# REDIS_SOCKET_TIMEOUT_S=0.5      # a slow Redis is bypassed for 30 s rather than slowing requests
# WARM_CLAIM_TTL_S=900            # only one worker per window runs the startup cache warm

# Public HTTPS hostname (set by scripts/setup-ssl.sh)
# PATRO_API_DOMAIN=84-235-248-118.sslip.io

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# When the API is served behind nginx at https://yourdomain.com/api/* set this so
# /api/docs (Swagger) loads /api/openapi.json instead of /openapi.json.
# FastAPI prepends this to openapi_url (/api + /openapi.json).
API_PUBLIC_PREFIX=/api

# Version segment for public data routes (…/api/v1/panchanga/…). Bump to v2 on a
# breaking engine change so the CDN serves fresh objects without a purge.
API_VERSION=v1

# Extra CORS origins (merged with built-in defaults: dpatro.vercel.app, GitHub Pages, localhost)
CORS_ALLOW_ORIGINS=https://sushilldhakal.github.io

# Warm holiday cache on startup (true/false)
PRECOMPUTE_ON_STARTUP=true

# BS years to precompute on startup, e.g. 2082,2083,2084
# PRECOMPUTE_BS_YEARS=

# Local dev: skip Postgres blob cache + panchanga SQLite (compute fresh / use cache/ on disk).
# Copy to .env.local (gitignored) or set when running uvicorn on localhost.
# PATRO_LOCAL_DEV=true
# BLOB_CACHE_USE_DB=false
# PANCHANGA_CACHE=false

# Years before/after current BS year when PRECOMPUTE_BS_YEARS is unset.
# ±3 = 7 popular years. Raise on a persistent host; keep small on ephemeral ones.
PRECOMPUTE_BS_SPAN=3

# Directory holding the Swiss Ephemeris .se1 binaries. Defaults to data/ephemeris,
# populated by `python scripts/install_ephemeris.py`. With the files present the
# engine uses the full Swiss binary ephemeris; without them it silently falls
# back to the built-in Moshier model. Override only to point at a shared mount.
# SWISSEPH_EPHE_PATH=/opt/swisseph/ephe

# ─── Auth / user accounts ───────────────────────────────────────────────────────
# When DATABASE_URL is unset the auth/profile routes are simply disabled and the
# panchanga API keeps working unchanged.
#
# PostgreSQL on this same server (recommended). Create the DB/user first — see
# deploy/AUTH_SETUP.md.
# DATABASE_URL=postgresql+psycopg://patro:CHANGE_ME@127.0.0.1:5432/patro

# Secret used to sign access/refresh tokens. Generate with:  openssl rand -hex 32
# JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=365

# Base URL of the web app — used to build email verification / reset links.
FRONTEND_URL=https://vedicpatro.com

# Google Sign-In — Web client ID (same value as VITE_GOOGLE_CLIENT_ID in dhakal-patro).
# Required for POST /auth/google; when unset that route returns 503.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Native ID tokens may use these as audience (optional; comma-separated extra IDs also work):
# GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_ANDROID_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Sign in with Apple — identity-token audience is the iOS bundle ID by default.
# APPLE_BUNDLE_ID=com.vedicpatro.mobile
# APPLE_SERVICES_ID=com.vedicpatro.mobile.web
# APPLE_CLIENT_IDS=com.vedicpatro.mobile,com.vedicpatro.mobile.web

# Facebook Login — app ID + secret from Meta for Developers.
# FACEBOOK_APP_ID must match VITE_FACEBOOK_APP_ID in dhakal-patro.
# Required for POST /auth/facebook; when unset that route returns 503.
# FACEBOOK_APP_ID=your-app-id
# FACEBOOK_APP_SECRET=your-app-secret

# Daily panchanga → Facebook Page post (see deploy/FB_DAILY_POST.md).
# Both required to enable; the poster stays dormant when unset.
# FB_PAGE_ID=your-page-numeric-id
# FB_PAGE_ACCESS_TOKEN=long-lived-page-access-token
# FB_GRAPH_API_VERSION=v21.0

# ─── Documents (शोत्र/स्तोत्र audio) ─────────────────────────────────────────────
# Public base URL the Cloudflare R2 bucket serves shloka audio + cover images
# from — either the bucket's R2.dev dev URL or a custom domain you mapped to
# it in the Cloudflare dashboard. GET /documents/{slug} prefixes each stored
# object key with this to build the playable audio_url/cover_image_url; the
# API itself never talks to R2 (no credentials needed here). Content and
# per-verse audio filenames come from data/documents_source/*.json — see that
# folder's README.
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ─── Email (SMTP) — needed for verification + password-reset emails ─────────────
# Leave SMTP_HOST unset to disable real sending (links are written to the log so
# you can still test the flows in development).
#
# Maileroo (verify the vedicpatro.com domain in Maileroo first — add the SPF/DKIM
 DNS records it gives you to Cloudflare, then copy the SMTP credentials here:
 SMTP_HOST=smtp.maileroo.com
 SMTP_PORT=587
 SMTP_USER=<your Maileroo SMTP username>
 SMTP_PASSWORD=<your Maileroo SMTP password/key>
 SMTP_FROM=noreply@vedicpatro.com
 SMTP_FROM_NAME=Vedic Patro
 SMTP_REPLY_TO=vedicnepalpatro@gmail.com
 SMTP_USE_TLS=true

# ── Facebook daily posts (see deploy/FB_DAILY_POST.md) ──
# Which posts run at sunrise: main (दिन-चक्र), periods (शुभ/अशुभ समय), d1 (D1 चक्र + ग्रह).
# FB_POST_KINDS=main,periods,d1
# Mobile-app link for the extra posts (caption + the image's reserved slot). Leave unset
# until the app is published.
# APP_LINK=
