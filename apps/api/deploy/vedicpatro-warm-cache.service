[Unit]
Description=Pre-build the pages people are about to open (Redis, disk and Cloudflare caches)
Documentation=https://github.com/sushilldhakal/patro/tree/main/apps/api/scripts/warm_cache.py
After=network-online.target nepali-holiday-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/patro
Environment=PYTHONUNBUFFERED=1
# Started by the nightly timer and, without waiting, by apps/api/scripts/deploy.sh
# after every API deploy. Ten years for every popular city (~123k pages): first
# straight from the API's loopback port with the public Host header (a page
# already in Redis costs ~1 ms, so a nightly pass takes minutes), then this
# week's pages through the public URL so Cloudflare holds them too.
ExecStart=/home/ubuntu/patro/.venv/bin/python apps/api/scripts/warm_cache.py --years 10 --workers 2 --origin http://127.0.0.1:8000/v1
# The building happens in the API workers; this process only sends requests, and
# never more than 2 at once — on 2 cores that leaves room for visitors, and it is
# below the load-shed lane. The very first ten-year build takes many hours.
Nice=10
TimeoutStartSec=20h
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vedicpatro-warm-cache
