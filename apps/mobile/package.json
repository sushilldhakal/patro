  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.4",
    "@types/three": "^0.185.4",
    "babel-preset-expo": "~57.0.0",
    "png-to-ico": "^3.0.2",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  }
