{
  "name": "@vedic-patro/mobile",
  "version": "1.2.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev:ios": "expo run:ios",
    "dev:android": "expo run:android",
    "lint": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "node scripts/generate-icons.mjs",
    "build:android": "eas build --platform android --profile production",
    "build:ios": "eas build --platform ios --profile production",
    "build:preview": "eas build --profile preview --platform all",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "release:check": "node scripts/release-check.mjs",
    "release": "node scripts/release.mjs",
    "release:ios": "node scripts/release.mjs --platform ios",
    "release:android": "node scripts/release.mjs --platform android",
    "release:android:production-track": "node scripts/release.mjs --platform android --submit-profile production-track",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/fira-code": "^0.4.1",
    "@expo-google-fonts/noto-sans-devanagari": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/native": "^7.1.6",
    "@react-three/fiber": "^9.8.2",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "@vedic-patro/api-client": "*",
    "@vedic-patro/design-tokens": "*",
    "@vedic-patro/domain": "*",
    "@vedic-patro/drawing": "*",
    "@vedic-patro/features": "*",
    "@vedic-patro/i18n": "*",
    "@vedic-patro/icons": "*",
    "@vedic-patro/read-models": "*",
    "@vedic-patro/ui": "*",
    "clsx": "^2.1.1",
    "expo": "~58.0.19",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-auth-session": "~58.0.14",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.11",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-gl": "~58.0.3",
    "expo-haptics": "~58.0.7",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.19",
    "expo-notifications": "~58.1.6",
    "expo-observe": "~58.0.16",
    "expo-router": "~58.0.26",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-task-manager": "~58.0.12",
    "expo-updates": "~58.0.18",
    "expo-web-browser": "~58.0.6",
    "healpix-ts": "^1.1.0",
    "lucide-react": "^0.487.0",
    "nativewind": "^4.1.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "three": "^0.185.1"
  },
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-camera"
        ]
      }
    }
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.3.0",
    "@types/three": "^0.185.4",
    "babel-preset-expo": "~58.0.0",
    "png-to-ico": "^3.0.2",
    "react-native-svg-transformer": "^1.5.3",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3"
  }
}
