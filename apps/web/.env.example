# Panchanga + Auth API base URL.
#
# Single-server (production): leave this UNSET. The app defaults to "/api", and
# nginx proxies /api → the FastAPI backend on the same box (same origin, no CORS).
# The build script sets VITE_API_BASE_URL=/api explicitly.
#
# Local dev: also leave UNSET — vite.config.ts proxies /api → http://localhost:8080.
# Only set this to point at a *different* host, e.g. the live API from local Vite:
#   VITE_API_BASE_URL=https://www.vedicpatro.com/api
# Use www (not apex) — vedicpatro.com 301s and cross-origin redirects fail CORS.
# No trailing slash.
# VITE_API_BASE_URL=

# Google Sign-In — the OAuth *Web* client ID from Google Cloud Console.
# Public value (safe in the bundle). Must match GOOGLE_CLIENT_ID on the API server.
# Leave unset to hide the Google button.
# In the OAuth client, add each site origin under "Authorized JavaScript origins"
# (used by the desktop button) AND add "<origin>/auth/google/callback" under
# "Authorized redirect URIs" (used by the mobile redirect flow), e.g.
#   https://dhakalpatro.com/auth/google/callback
#   http://localhost:5173/auth/google/callback
# VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Facebook Login — app ID from Meta for Developers (Facebook Login → Settings).
# Public value (safe in the bundle). Must match FACEBOOK_APP_ID on the API server.
# Leave unset to hide the Facebook button.
# VITE_FACEBOOK_APP_ID=your-app-id

# Google Analytics 4 — measurement ID from GA4 property (Admin → Data streams).
# Leave unset to disable analytics (no-op in the app).
# Local dev: set here. Production deploy: also add the same value as a GitHub
# repo secret named VITE_GA_MEASUREMENT_ID (Settings → Secrets → Actions).
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Panchanga engine cache version — keep in sync with nepali-holiday-api
# services/panchanga_cache.py CACHE_PAYLOAD_VERSION. Bumps the `cv=` query on
# panchanga API URLs so Cloudflare serves fresh JSON after engine changes.
# VITE_PANCHANGA_CACHE_VERSION=18
