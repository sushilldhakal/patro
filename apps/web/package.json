{
  "name": "@vedic-patro/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run i18n && vite",
    "dev:lan": "npm run i18n && VITE_API_BASE_URL=/api vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "npm run i18n && npm run chapters:check && npm run generate-sitemap && tsc -b && npm run build:client && npm run build:server && npm run prerender",
    "i18n": "npm run generate -w @vedic-patro/i18n",
    "i18n:check": "npm run lint -w @vedic-patro/i18n",
    "i18n:report": "npm run report -w @vedic-patro/i18n",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:lint": "node scripts/i18n-lint.mjs",
    "generate-sitemap": "TSX_TSCONFIG_PATH=./tsconfig.app.json tsx scripts/generate-sitemap.mjs",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist/server",
    "prerender": "node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "chapters:check": "TSX_TSCONFIG_PATH=./tsconfig.app.json tsx scripts/check-chapters.ts",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "healpix-ts": "^1.1.0",
    "i18next": "^26.3.4",
    "lucide-react": "^1.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "@vedic-patro/domain": "*",
    "@vedic-patro/i18n": "*",
    "@vedic-patro/api-client": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tsx": "^4.23.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
