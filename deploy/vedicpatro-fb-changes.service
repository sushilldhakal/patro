[Unit]
Description=Post Kathmandu panchanga anga changes (tithi/nakshatra/yoga/karana) to Facebook
Documentation=https://github.com/sushilldhakal/patro
After=network-online.target nepali-holiday-api.service
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/patro
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/home/ubuntu/patro/.env
ExecStart=/home/ubuntu/patro/.venv/bin/python scripts/post_panchanga_changes.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vedicpatro-fb-changes
