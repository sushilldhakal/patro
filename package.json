{
  "name": "vedic-patro",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "web": "npm run dev -w @vedic-patro/web",
    "mobile": "npm run start -w @vedic-patro/mobile",
    "tokens": "npm run generate -w @vedic-patro/design-tokens",
    "i18n": "npm run generate -w @vedic-patro/i18n",
    "check:shared": "node scripts/check-shared-usage.mjs",
    "check:design": "node scripts/check-design-drift.mjs",
    "check:classes": "node scripts/check-shared-classes.mjs",
    "check:copy": "node scripts/check-inline-copy.mjs",
    "check:duplicates": "node scripts/check-duplicate-components.mjs"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "decode-uri-component": "^0.5.0",
    "uuid": "^11.1.1",
    "postcss-selector-parser": "^7.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  }
}
