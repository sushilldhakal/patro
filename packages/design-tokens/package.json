{
  "name": "@vedic-patro/design-tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design values (colours, type, spacing, radii, shadows, sizes, motion, breakpoints) for the website and the mobile app.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mobile-tailwind.json": "./generated/mobile-tailwind.json",
    "./classes/*": {
      "import": "./src/classes/*.ts",
      "default": "./src/classes/*.ts"
    },
    "./classes/patro-classes": {
      "import": "./src/classes/patro-classes.ts",
      "default": "./src/classes/patro-classes.ts"
    },
    "./classes/timeline-classes": {
      "import": "./src/classes/timeline-classes.ts",
      "default": "./src/classes/timeline-classes.ts"
    },
    "./classes/wheel-classes": {
      "import": "./src/classes/wheel-classes.ts",
      "default": "./src/classes/wheel-classes.ts"
    },
    "./classes/wheel-svg-classes": {
      "import": "./src/classes/wheel-svg-classes.ts",
      "default": "./src/classes/wheel-svg-classes.ts"
    },
    "./classes/learn-classes": {
      "import": "./src/classes/learn-classes.ts",
      "default": "./src/classes/learn-classes.ts"
    },
    "./classes/hora-classes": {
      "import": "./src/classes/hora-classes.ts",
      "default": "./src/classes/hora-classes.ts"
    },
    "./classes/av-wheel-classes": {
      "import": "./src/classes/av-wheel-classes.ts",
      "default": "./src/classes/av-wheel-classes.ts"
    },
    "./classes/diagram-classes": {
      "import": "./src/classes/diagram-classes.ts",
      "default": "./src/classes/diagram-classes.ts"
    },
    "./cn": "./src/cn.ts",
    "./classes/*": {
      "import": "./src/classes/*.ts",
      "default": "./src/classes/*.ts"
    }
  },
  "dependencies": {
    "@vedic-patro/domain": "*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "scripts": {
    "generate": "tsx scripts/generate-css.ts",
    "lint": "tsx scripts/generate-css.ts --check",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.8"
  }
}
