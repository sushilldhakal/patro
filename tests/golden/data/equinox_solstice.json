  "description": "Tropical equinox and solstice instants, solved from the definition against Swiss Ephemeris.",
  "source": {
    "authority": "Swiss Ephemeris 2.10.03 (DE441) evaluated against a mathematical definition",
    "kind": "mathematical_definition",
    "definition": "The instant at which the apparent geocentric TROPICAL solar longitude reaches exactly 0 deg (March equinox), 90 deg (June solstice), 180 deg (September equinox) or 270 deg (December solstice).",
    "method": "Independent bisection in tests/golden/definitions.py on swe.calc_ut(SUN, FLG_SWIEPH), bracketed +/-20 days around the nominal date, converged to 1 second. Deliberately shares no code with the production solver, which uses Brent's method with its own bracketing.",
    "reference": "tests/golden/definitions.py::equinox_solstice_jd",
    "publication_year": "n/a (derived, not published)",
    "convention": "Apparent geocentric tropical longitude, UT timescale (JD UT, matching the engine's UT contract). No nutation or aberration adjustment beyond what swe.calc_ut applies by default.",
    "retrieved": "2026-08-02",
    "verified_by": "Convergence checked: solved longitudes land within 3e-6 deg of target. Cross-check: the 2000 March equinox solves to 2000-03-20 07:35 UT, matching the widely published instant.",
    "notes": "Derived, not transcribed. Swiss Ephemeris is this engine's astronomical authority, so this dataset verifies the PRODUCTION SOLVER converges to the definition - not that the ephemeris is correct."
  },
  "tolerance": {
    "value": 60,
    "unit": "seconds",
    "rationale": "The reference solver converges to 1 s and production targets 60 s. A 60 s tolerance therefore accepts production's own stated precision while still detecting a bracketing or convergence fault, which shows up as minutes or more. It is also far tighter than the ~8 s difference between the Meeus series in tropical_seasons and Swiss Ephemeris, so this dataset can adjudicate that migration."
  },
  "reconciled_under_provenance": "1a29d9327c09017b650e42c91ae90f44da6f213e084fd4518f849be901a80ec8",
  "required_entry_fields": [
    "id",
    "year",
    "event",
    "expected"
  ],
